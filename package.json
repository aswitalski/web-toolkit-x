{
  "name": "web-toolkit-x",
  "version": "0.71.0",
  "description": "Web Toolkit X, a Web UI toolkit",
  "scripts": {
    "typecheck": "node node_modules/typescript-7/lib/tsc.js -p . && node node_modules/typescript-7/lib/tsc.js -p test && node node_modules/typescript-7/lib/tsc.js -p demo",
    "test": "vitest run --browser=chromium",
    "test:browsers": "vitest run",
    "coverage": "vitest run --coverage --browser=chromium",
    "bench": "vitest bench --run --reporter=verbose --browser=chromium",
    "lint": "eslint .",
    "format": "prettier --write .",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "verify": "npm run build && npm run typecheck && npm run lint && prettier --check .",
    "demo": "npm run build && vite demo --mode release",
    "prepublishOnly": "npm run verify",
    "prepare": "simple-git-hooks"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aswitalski/web-toolkit-x.git"
  },
  "keywords": [
    "web ui",
    "toolkit",
    "native",
    "javascript",
    "framework",
    "virtual dom"
  ],
  "author": "Aleksander Świtalski",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/aswitalski/web-toolkit-x/issues"
  },
  "homepage": "https://github.com/aswitalski/web-toolkit-x#readme",
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@vitest/browser-playwright": "^5.0.3",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "lint-staged": "^17.6.0",
    "playwright": "^1.64.0",
    "prettier": "^3.9.9",
    "publint": "^0.3.25",
    "simple-git-hooks": "^2.14.0",
    "tsdown": "^0.23.0",
    "typescript": "~6.0.3",
    "typescript-7": "npm:typescript@^7.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "type": "module",
  "types": "./dist/release/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/release/index.d.ts",
      "default": "./dist/release/index.js"
    },
    "./global": {
      "types": "./dist/release/global.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/release",
    "src",
    "NOTICE",
    "AUTHORS"
  ],
  "allowScripts": {
    "simple-git-hooks@2.14.0": true,
    "fsevents": false
  },
  "engines": {
    "node": ">=24"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged",
    "pre-push": "npm run typecheck && npm test && npm run build && npm run lint"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,html,css,yml,md}": "prettier --write"
  }
}
